server {
    listen 443 ssl;
    server_name {{ ansible_host }};

    ssl_certificate     {{ tls_directory }}/ollama.crt;
    ssl_certificate_key {{ tls_directory }}/ollama.key;

    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        auth_basic "Ollama API";
        auth_basic_user_file {{ nginx_auth_directory }}/ollama.htpasswd;

        proxy_pass http://127.0.0.1:{{ ollama_port }};

        proxy_http_version 1.1;

        proxy_set_header Host localhost:{{ ollama_port }};
        proxy_set_header X-Real-IP $remote_addr;

        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
